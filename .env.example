# MountGuard Backup — configuration (copy to /etc/mountguard-backup.env).
# Every value is read fresh at request time, so changes apply on service restart.

# Bind address. 0.0.0.0 = reachable on the network (keep on a trusted LAN/VPN).
BACKUP_UI_HOST=0.0.0.0
BACKUP_UI_PORT=8000

# Where the SQLite job/run database and per-run rsync logs live.
# install.sh creates these. If they are not writable, the app falls back to
# ./data and ./logs in the app directory (useful for non-root dev runs).
BACKUP_UI_STATE_DIR=/var/lib/backup-ui
BACKUP_UI_LOG_DIR=/var/log/backup-ui

# Default timezone offered in the job editor. Central time is canonicalized to
# the IANA zone America/Chicago so CST/CDT daylight-saving is handled correctly.
BACKUP_UI_TIMEZONE=America/Chicago

# Path to the rsync executable.
BACKUP_UI_RSYNC=rsync

# Bounded run-history retention per job, and max bytes kept per run log file.
BACKUP_UI_MAX_RUNS=50
BACKUP_UI_LOG_MAX_BYTES=262144
